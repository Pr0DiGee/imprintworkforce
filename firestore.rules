rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helper functions ──────────────────────────────────────────────
    function isAuth() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(uid())).data;
    }

    function userDepartments() {
      return userDoc().get('departments', []);
    }

    function hasPermission(roles, departments) {
      return isAuth()
        && (userDoc().get('role', '') in roles || userDepartments().hasAny(departments));
    }

    // <generated:permissions>
    // Generated from lib/permissions.ts by `npm run rules:sync`. Do not edit by hand.
    function canManageUsers() {
      return hasPermission(['ADMIN'], []);
    }
    function canViewAllReports() {
      return hasPermission(['PASTOR', 'LEAD_PASTOR', 'ADMIN'], []);
    }
    function canWriteAnyReport() {
      return hasPermission(['LEAD_PASTOR', 'ADMIN'], []);
    }
    function canViewAllTasks() {
      return hasPermission(['PASTOR', 'LEAD_PASTOR', 'ADMIN'], []);
    }
    function canAssignTasks() {
      return hasPermission(['PASTOR', 'LEAD_PASTOR', 'ADMIN'], []);
    }
    function canEditRoster() {
      return hasPermission(['PASTOR', 'LEAD_PASTOR', 'ADMIN'], []);
    }
    function canEditDevotion() {
      return hasPermission(['PASTOR', 'LEAD_PASTOR', 'ADMIN'], ['DEVOTION']);
    }
    function canManageAttendance() {
      return hasPermission(['PASTOR', 'LEAD_PASTOR', 'ADMIN'], ['USHERING']);
    }
    function canManageAllFollowUps() {
      return hasPermission(['PASTOR', 'LEAD_PASTOR', 'ADMIN'], []);
    }
    // </generated:permissions>

    // ─── Users ─────────────────────────────────────────────────────────
    match /users/{userId} {
      // Any authenticated user can read any user profile (needed for name lookups)
      allow read: if isAuth();

      // Only admins write user profiles from the browser. Users change their own
      // name, photo, email and password through server routes (Admin SDK), so they
      // can never touch their own role or departments.
      allow write: if canManageUsers();
    }

    // ─── Reports ───────────────────────────────────────────────────────
    // Report ID format: DEPARTMENT_YYYY-MM-DD

    function canWriteReportFor(department) {
      return canWriteAnyReport() || department in userDepartments();
    }

    // 24 hours after submission a report is final for EVERYONE, admins included
    // (the admin catch-all below skips this collection). Keep in sync with
    // REPORT_EDIT_WINDOW_MS in app/dashboard/reports/ReportsClient.tsx.
    function reportLocked() {
      return resource.data.get('status', '') == 'SUBMITTED'
        && resource.data.get('submitted_at', null) is timestamp
        && request.time > resource.data.submitted_at + duration.value(24, 'h');
    }

    match /reports/{reportId} {
      allow read: if isAuth();

      allow create: if canWriteReportFor(request.resource.data.department)
        && reportId == request.resource.data.department + '_' + request.resource.data.target_sunday;

      // Department, date and submission time can't be changed (no resetting the clock)
      allow update: if !reportLocked()
        && canWriteReportFor(resource.data.department)
        && request.resource.data.department == resource.data.department
        && request.resource.data.target_sunday == resource.data.target_sunday
        && (resource.data.get('submitted_at', null) == null
            || request.resource.data.get('submitted_at', null) == resource.data.submitted_at);

      allow delete: if false;
    }

    // ─── Tasks ─────────────────────────────────────────────────────────
    match /tasks/{taskId} {
      // Everyone sees tasks assigned to them; some roles see all tasks
      allow read: if canViewAllTasks()
                  || (isAuth() && resource.data.assigned_to == uid());

      allow create, delete: if canAssignTasks();

      // Assigners can update any task; the assignee can only change the status
      allow update: if canAssignTasks()
                    || (isAuth()
                        && resource.data.assigned_to == uid()
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']));
    }

    // ─── Roster ────────────────────────────────────────────────────────
    match /roster/{entry} {
      // Any authenticated user can read roster
      allow read: if isAuth();

      allow write: if canEditRoster();
    }

    // ─── Devotion ──────────────────────────────────────────────────────
    match /devotion/{entry} {
      // Any authenticated user can read devotion schedule
      allow read: if isAuth();

      allow write: if canEditDevotion();
    }

    // ─── Feedback ──────────────────────────────────────────────────────
    match /feedback/{feedbackId} {
      // Any authenticated user can read all feedback
      allow read: if isAuth();

      // Users can only write their own feedback doc (ID format: YYYY-MM-DD_UID)
      allow create, update: if isAuth()
                            && feedbackId.matches('.*_' + uid())
                            && request.resource.data.user_id == uid();
    }

    // ─── Congregation & Attendance ─────────────────────────────────────
    // Check-in and member edits go through server code (Admin SDK), which
    // bypasses these rules. Browsers can't write these collections (apart from
    // the admin catch-all at the bottom).
    match /congregation/{memberId} {
      allow read: if canManageAttendance();
      allow write: if false;
    }

    match /attendance/{recordId} {
      allow read: if canManageAttendance();
      allow write: if false;
    }

    // ─── Worker Notes (Private) ──────────────────────────────────────
    match /note_folders/{folderId} {
      // Users can only read/write their own folders
      allow read, write: if isAuth() && resource == null
        ? request.resource.data.user_id == uid()
        : resource.data.user_id == uid();
      allow create: if isAuth() && request.resource.data.user_id == uid();
    }

    match /notes/{noteId} {
      // Users can only read/write their own notes
      allow read, write: if isAuth() && resource == null
        ? request.resource.data.user_id == uid()
        : resource.data.user_id == uid();
      allow create: if isAuth() && request.resource.data.user_id == uid();
    }

    // ─── Follow-Up ─────────────────────────────────────────────────────
    match /followup_contacts/{contactId} {
      // All authenticated users can read the global list
      allow read: if isAuth();
      // Any authenticated user can create a contact
      allow create: if isAuth();
      // Users can only update or delete contacts assigned to them (unless allowed to manage all)
      allow update, delete: if isAuth() && (resource.data.assigned_to == uid() || canManageAllFollowUps());
    }

    match /followup_logs/{logId} {
      // All authenticated users can read logs
      allow read: if isAuth();
      // A user can only log for themselves
      allow create: if isAuth() && request.resource.data.worker_id == uid();
      allow update, delete: if isAuth() && resource.data.worker_id == uid();
    }

    // Admin super-user: full access everywhere except reports, whose 24-hour
    // lock must hold for everyone (admins write reports via the rules above).
    match /{collection}/{document=**} {
      allow read, write: if canManageUsers() && collection != 'reports';
    }
  }
}
